---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeCollection from '../components/HomeCollection.astro';
import {NAME} from '../lib/content';
import {getHomeData} from '../lib/home';
import '../styles/home.css';
const {copy}=getHomeData();
---
<BaseLayout title={NAME} description={copy.intro} active="entries" cite>
 <main id="main" class="wrap home-page" data-home>
  <section class="home-heading">
   <div><h1>{NAME}</h1><p>{copy.intro}</p></div>
   <form class="home-search" action="/search/" method="get" role="search" data-home-search>
    <label for="home-search-input">{copy.labels.search_label}</label>
    <div class="home-search-field"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg><input id="home-search-input" name="q" type="search" placeholder={copy.labels.search_placeholder}/><button type="submit">{copy.labels.search_button}</button></div>
   </form>
  </section>
  <HomeCollection/>
 </main>
</BaseLayout>
