---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryFeed from '../components/EntryFeed.astro';
import CategoryLinks from '../components/CategoryLinks.astro';
import {getEntries,NAME,TAGLINE} from '../lib/content';
const entries=getEntries();
---
<BaseLayout title={NAME} description={TAGLINE} active="entries" cite>
 <main id="main" class="wrap"><section class="home-heading"><h1>{NAME}</h1><p>Small research experiments with AI agents, checking claims against primary data.</p></section><section class="home-feed"><div class="feed-heading"><h2 class="sec">Entries</h2><a href="/rss.xml">RSS</a></div><CategoryLinks/><EntryFeed entries={entries}/></section></main>
</BaseLayout>
