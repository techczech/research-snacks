---
import BaseLayout from '../layouts/BaseLayout.astro';
import {getEntries} from '../lib/content';
import {resolveDatasets,catalogueIntro,accessKey,accessTypes,catalogueSource} from '../lib/datasets';
import '../styles/data-sources.css';
const datasets=resolveDatasets(getEntries());
---
<BaseLayout title="Data sources · Research Snacks" description={catalogueIntro} active="data-sources" cite>
 <main id="main" class="wrap sources-page" data-sources>
  <h1>Data sources</h1>
  <p class="sources-intro">{catalogueIntro}</p>
  <p class="sources-downloads"><a href={catalogueSource.repository}>Catalogue on GitHub</a> · <a href="/data-sources/datasets.csv">CSV</a> · <a href="/data-sources/datasets.json">JSON</a></p>
  <details class="sources-key"><summary>Access key</summary><p>{accessKey}</p></details>
  <form class="sources-tools" hidden data-source-tools role="search">
   <label class="sources-search" for="source-query">Search data sources<input id="source-query" name="q" type="search" placeholder="Title, provider, description or notes" autocomplete="off" /></label>
   <label for="source-access">Access<select id="source-access" name="access"><option value="">All access types</option>{accessTypes.map(a=><option value={a}>{a}</option>)}</select></label>
   <label for="source-use">Used in a snack<select id="source-use" name="use"><option value="">All datasets</option><option value="used">Used in a snack</option><option value="considered">Considered only</option></select></label>
   <label for="source-sort">Sort<select id="source-sort" name="sort"><option value="title">Title A–Z</option><option value="title-desc">Title Z–A</option><option value="provider">Provider A–Z</option></select></label>
   <button type="reset">Clear filters</button>
  </form>
  <p class="sources-count" role="status" aria-live="polite" aria-atomic="true" data-source-count>{datasets.length} datasets · Title A–Z</p>
  <p hidden data-source-empty>No data sources match. Try a different search or <button type="button" data-source-clear>clear filters</button>.</p>
  <div class="sources-list" data-source-list>
   {datasets.map(d=><article id={d.id} class="source-record" data-source-record data-access={d.access} data-used={d.snacks.length?'used':'considered'} data-provider={d.provider} data-title={d.title}>
    <div class="source-description"><h2><a href={d.url}>{d.title}</a></h2><p class="source-provider">{d.provider}</p><p>{d.data}</p></div>
    <div class="source-terms"><p><b>Access:</b> {d.access}</p><p><b>Licence:</b> <a href={d.licence.url}>{d.licence.name}</a></p></div>
    <div class="source-usage">{d.snacks.length?<><h3>Used in</h3><ul>{d.snacks.map(s=><li><a href={s.href}>{s.title}</a></li>)}</ul></>:<p class="source-considered">Considered only · not used in a snack</p>}</div>
    {d.notes&&<details class="source-notes"><summary>Notes</summary><p>{d.notes}</p></details>}
   </article>)}
  </div>
  <p class="sources-provenance">Catalogue snapshot: <a href={`${catalogueSource.repository}/tree/${catalogueSource.commit}`}>{catalogueSource.commit.slice(0,7)}</a>.</p>
 </main>
</BaseLayout>
<script>import {initDataSources} from '../scripts/data-sources';initDataSources();</script>
