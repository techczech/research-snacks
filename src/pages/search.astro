---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntries } from '../lib/content';
---
<BaseLayout title="Search · Research Snacks" description="Find a Research Snack or site page" cite>
  <main id="main" class="wrap entry search-page"><h1>Search Research Snacks</h1><form action="/search/" method="get"><label for="fallback-search">Search entries and pages</label><input id="fallback-search" name="q" type="search" /><button type="submit">Search</button></form><p>With JavaScript off, browse all entries and pages below, or use your browser’s find command.</p><ul><li><a href="/">Entries</a></li><li><a href="/about/">About</a></li>{getEntries().map(x => <li><a href={`/${x.id}/`}>{x.title}</a><p>{x.summary}</p></li>)}</ul></main>
</BaseLayout>
