{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#ffffff",
  "width": 580,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#e6e5df"
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 12,
      "labelLimit": 330
    },
    "title": {
      "anchor": "start",
      "fontSize": 18,
      "subtitleFontSize": 12,
      "subtitleColor": "#555555"
    }
  },
  "title": {
    "text": "Selected protest-to-departure clocks",
    "subtitle": [
      "Sixteen chosen episodes, 1848–2024; final protest episode, not whole campaign.",
      "Libya uses loss of the capital; mixed mechanisms are tested separately."
    ]
  },
  "height": 470,
  "mark": {
    "type": "point",
    "filled": true,
    "size": 100
  },
  "params": [
    {
      "name": "era_pick",
      "select": {
        "type": "point",
        "fields": [
          "era"
        ]
      },
      "bind": "legend"
    }
  ],
  "encoding": {
    "y": {
      "field": "case",
      "type": "nominal",
      "sort": [
        "France 1848",
        "Russia 1917",
        "Iran 1978–79",
        "Philippines 1986",
        "East Germany 1989",
        "Czechoslovakia 1989",
        "Romania 1989",
        "Serbia 2000",
        "Georgia 2003",
        "Tunisia 2010–11",
        "Egypt 2011",
        "Libya 2011",
        "Yemen 2011–12",
        "Sudan 2018–19",
        "Sri Lanka 2022",
        "Bangladesh 2024"
      ],
      "title": null,
      "axis": {
        "labelLimit": 210
      }
    },
    "x": {
      "field": "elapsed_days",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "domain": [
          1,
          500
        ]
      },
      "axis": {
        "values": [
          1,
          3,
          10,
          30,
          100,
          300
        ],
        "format": "d"
      },
      "title": "Elapsed days (logarithmic scale)"
    },
    "color": {
      "field": "era",
      "type": "nominal",
      "scale": {
        "domain": [
          "Before 1990",
          "1990–2009",
          "2010–2024"
        ],
        "range": [
          "#626b75",
          "#d47629",
          "#167e86"
        ]
      },
      "legend": {
        "title": null
      }
    },
    "opacity": {
      "condition": {
        "param": "era_pick",
        "value": 1
      },
      "value": 0.2
    },
    "tooltip": [
      {
        "field": "case"
      },
      {
        "field": "start",
        "title": "Start"
      },
      {
        "field": "end",
        "title": "End"
      },
      {
        "field": "elapsed_days",
        "title": "Elapsed days"
      },
      {
        "field": "mechanism"
      }
    ]
  },
  "data": {
    "url": "charts/1-selected-clocks.csv"
  }
}
