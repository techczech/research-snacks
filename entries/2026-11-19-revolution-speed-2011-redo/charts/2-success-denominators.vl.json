{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#ffffff",
  "width": 580,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#e6e5df"
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 12,
      "labelLimit": 330
    },
    "title": {
      "anchor": "start",
      "fontSize": 18,
      "subtitleFontSize": 12,
      "subtitleColor": "#555555"
    }
  },
  "title": {
    "text": "NAVCO success depends on the denominator",
    "subtitle": [
      "Primarily nonviolent maximalist campaigns grouped by peak decade.",
      "Preliminary NAVCO 1.3; outcomes observed through 31 December 2019."
    ]
  },
  "height": 310,
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  },
  "params": [
    {
      "name": "denom_pick",
      "select": {
        "type": "point",
        "fields": [
          "denominator"
        ]
      },
      "bind": "legend"
    }
  ],
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "title": "Peak decade",
      "axis": {
        "labelAngle": 0
      }
    },
    "xOffset": {
      "field": "denominator"
    },
    "y": {
      "field": "success_pct",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "title": "Full success (%)"
    },
    "color": {
      "field": "denominator",
      "type": "nominal",
      "scale": {
        "domain": [
          "All campaigns, status at 2019",
          "Exclude ongoing campaigns"
        ],
        "range": [
          "#167e86",
          "#d47629"
        ]
      },
      "legend": {
        "title": null,
        "columns": 1
      }
    },
    "opacity": {
      "condition": {
        "param": "denom_pick",
        "value": 1
      },
      "value": 0.2
    },
    "tooltip": [
      {
        "field": "decade"
      },
      {
        "field": "denominator"
      },
      {
        "field": "success_pct",
        "format": ".1f"
      },
      {
        "field": "campaigns"
      },
      {
        "field": "successes"
      },
      {
        "field": "ongoing"
      },
      {
        "field": "resolved"
      }
    ]
  },
  "data": {
    "url": "charts/2-success-denominators.csv"
  }
}
