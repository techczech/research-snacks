{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "orient": "top",
      "title": null,
      "labelFontSize": 12
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "subtitleFontSize": 12
    }
  },
  "width": 830,
  "height": {
    "step": 24
  },
  "title": {
    "text": "39 curated sickly example locators",
    "subtitle": "Corpus text withheld; recover contexts through licensed access."
  },
  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "row"
        }
      ]
    },
    {
      "calculate": "datum.corpus + ' | ' + datum.document_id + ' | ' + datum.token + ' | ' + datum.construction + ' | ' + datum.reading",
      "as": "excerpt"
    }
  ],
  "mark": {
    "type": "text",
    "align": "left",
    "baseline": "middle",
    "limit": 820,
    "fontSize": 16
  },
  "encoding": {
    "x": {
      "value": 0
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "text": {
      "field": "excerpt"
    },
    "tooltip": [
      {
        "field": "example"
      },
      {
        "field": "corpus"
      },
      {
        "field": "token"
      },
      {
        "field": "document_id"
      },
      {
        "field": "construction"
      },
      {
        "field": "coordination"
      },
      {
        "field": "reading"
      }
    ]
  },
  "data": {
    "url": "charts/2-sickly-kwic.csv"
  }
}
