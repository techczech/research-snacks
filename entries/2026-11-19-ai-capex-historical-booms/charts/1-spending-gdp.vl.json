{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#343d46",
      "titleColor": "#343d46",
      "gridColor": "#dedfdc",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "orient": "top",
      "title": null,
      "labelFontSize": 12,
      "labelLimit": 530
    },
    "title": {
      "anchor": "start",
      "fontSize": 19,
      "subtitleFontSize": 12,
      "subtitleColor": "#4b5563"
    },
    "background": "#fbfaf7"
  },
  "width": 610,
  "height": {
    "step": 32
  },
  "title": {
    "text": "A close twentieth-century precedent; larger earlier booms",
    "subtitle": [
      "Annual spending / GDP (%). Historical domestic series versus global company proxy.",
      "AI allocation and pace are scenarios, not bounds on measured domestic AI investment."
    ]
  },
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": [
        "UK railways (1847)",
        "US railways, 1870s (1871)",
        "US railways, 1880s (1881)",
        "AI: Q3 cash pace (2026)",
        "AI: reported proxy (2026)",
        "US railways, 1900-1914 (1910)",
        "AI: 70% allocation scenario (2026)",
        "US broadband providers (2000)",
        "US private electricity (1924)",
        "Apollo including overhead (1964)",
        "US federal interstates (1964)",
        "Manhattan Project (1944)"
      ],
      "title": null,
      "axis": {
        "labelLimit": 270
      }
    },
    "x": {
      "field": "peak_spend_pct_gdp",
      "type": "quantitative",
      "title": "Spending as a share of GDP (%)",
      "scale": {
        "domain": [
          0,
          7.1
        ]
      }
    },
    "tooltip": [
      {
        "field": "label",
        "title": "Case"
      },
      {
        "field": "peak_spend_pct_gdp",
        "type": "quantitative",
        "format": ".2f",
        "title": "GDP share (%)"
      },
      {
        "field": "scope",
        "title": "Coverage"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2
      },
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "status"
            ]
          },
          "bind": "legend"
        }
      ],
      "encoding": {
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Historical private industry",
              "Public programme",
              "Article proxy",
              "AI scenario"
            ],
            "range": [
              "#126782",
              "#89969d",
              "#b86412",
              "#cf9a45"
            ]
          },
          "legend": {
            "direction": "vertical"
          }
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 1
          },
          "value": 0.2
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "color": "#253341"
      },
      "encoding": {
        "text": {
          "field": "peak_spend_pct_gdp",
          "format": ".1f"
        }
      }
    }
  ],
  "data": {
    "url": "charts/1-spending-gdp.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "peak_spend_pct_gdp": "number"
      }
    }
  }
}
