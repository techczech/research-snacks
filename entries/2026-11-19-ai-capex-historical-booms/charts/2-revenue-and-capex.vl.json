{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#343d46",
      "titleColor": "#343d46",
      "gridColor": "#dedfdc",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "orient": "top",
      "title": null,
      "labelFontSize": 12,
      "labelLimit": 530
    },
    "title": {
      "anchor": "start",
      "fontSize": 19,
      "subtitleFontSize": 12,
      "subtitleColor": "#4b5563"
    },
    "background": "#fbfaf7"
  },
  "title": {
    "text": "Growth paths for railways, telecom and AI",
    "subtitle": [
      "Each series starts at 100 independently; common logarithmic scale.",
      "AI: October revenue run rate and Q3 capex estimates; adjacent periods, different cohort."
    ]
  },
  "facet": {
    "row": {
      "field": "precedent",
      "type": "nominal",
      "sort": [
        "UK railways",
        "US railways",
        "US telecom",
        "AI: estimates"
      ],
      "header": {
        "labelFontSize": 15,
        "labelFontWeight": "bold",
        "labelAngle": 0,
        "labelAlign": "left",
        "title": null
      }
    }
  },
  "spec": {
    "width": 560,
    "height": 135,
    "mark": {
      "type": "line",
      "point": {
        "filled": true,
        "size": 38
      }
    },
    "params": [
      {
        "name": "seriespick",
        "select": {
          "type": "point",
          "fields": [
            "series"
          ]
        },
        "bind": "legend"
      }
    ],
    "encoding": {
      "x": {
        "field": "period",
        "type": "ordinal",
        "title": "Calendar year",
        "axis": {
          "labelAngle": 0
        }
      },
      "y": {
        "field": "index_first_observation_100",
        "type": "quantitative",
        "title": "Index; first value = 100 (log)",
        "scale": {
          "type": "log",
          "domain": [
            45,
            1000
          ]
        },
        "axis": {
          "values": [
            50,
            100,
            200,
            500,
            1000
          ]
        }
      },
      "color": {
        "field": "series",
        "type": "nominal",
        "scale": {
          "domain": [
            "Capex",
            "Revenue"
          ],
          "range": [
            "#b86412",
            "#126782"
          ]
        }
      },
      "strokeDash": {
        "condition": {
          "test": "datum.series === 'Capex'",
          "value": [
            1,
            0
          ]
        },
        "value": [
          7,
          2
        ]
      },
      "opacity": {
        "condition": {
          "param": "seriespick",
          "value": 1
        },
        "value": 0.2
      },
      "tooltip": [
        {
          "field": "precedent"
        },
        {
          "field": "period",
          "title": "Year"
        },
        {
          "field": "series"
        },
        {
          "field": "index_first_observation_100",
          "type": "quantitative",
          "format": ".1f",
          "title": "Index"
        },
        {
          "field": "basis"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "x": "independent"
    }
  },
  "data": {
    "url": "charts/2-revenue-and-capex.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "index_first_observation_100": "number"
      }
    }
  }
}
