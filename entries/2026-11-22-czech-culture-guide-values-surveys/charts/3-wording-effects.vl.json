{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "data": {
    "url": "charts/3-wording-effects.csv"
  },
  "title": {
    "text": "Czech answers fall where the Czech wording changed",
    "subtitle": [
      "EVS 2017 vs WVS 2022, Czechia and Slovakia, weighted"
    ],
    "anchor": "start"
  },
  "facet": {
    "column": {
      "field": "item",
      "type": "nominal",
      "title": null
    }
  },
  "spec": {
    "width": 130,
    "height": 240,
    "mark": {
      "type": "bar"
    },
    "params": [
      {
        "name": "pick",
        "select": {
          "type": "point",
          "fields": [
            "country"
          ]
        },
        "bind": "legend"
      }
    ],
    "encoding": {
      "x": {
        "field": "survey",
        "type": "nominal",
        "title": null,
        "axis": {
          "labelAngle": 0
        }
      },
      "xOffset": {
        "field": "country"
      },
      "y": {
        "field": "percent",
        "type": "quantitative",
        "title": "% of adults",
        "scale": {
          "domain": [
            0,
            100
          ]
        }
      },
      "color": {
        "field": "country",
        "type": "nominal",
        "title": null,
        "scale": {
          "domain": [
            "Czechia",
            "Slovakia"
          ],
          "range": [
            "#1f5fa8",
            "#d9822b"
          ]
        }
      },
      "opacity": {
        "condition": {
          "param": "pick",
          "value": 1
        },
        "value": 0.25
      },
      "tooltip": [
        {
          "field": "item"
        },
        {
          "field": "country"
        },
        {
          "field": "survey"
        },
        {
          "field": "percent",
          "type": "quantitative"
        },
        {
          "field": "lo",
          "type": "quantitative"
        },
        {
          "field": "hi",
          "type": "quantitative"
        },
        {
          "field": "n",
          "type": "quantitative"
        }
      ]
    }
  }
}