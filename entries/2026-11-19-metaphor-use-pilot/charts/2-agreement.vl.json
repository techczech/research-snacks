{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 560,
  "height": 280,
  "background": "#fbfaf7",
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "Raw agreement can hide poor replication",
    "subtitle": [
      "n = 51 common metaphor-marked word units",
      "Labels show raw agreement and Cohen’s κ; bars show raw agreement"
    ]
  },
  "data": {
    "url": "charts/2-agreement.csv"
  },
  "encoding": {
    "y": {
      "field": "display",
      "type": "nominal",
      "sort": [
        "Cognitive use",
        "Figurative appeal",
        "Social label sets",
        "Textual binding",
        "Scope in excerpt"
      ],
      "title": null
    },
    "tooltip": [
      {
        "field": "display",
        "title": "Dimension"
      },
      {
        "field": "n",
        "type": "quantitative",
        "title": "Paired units"
      },
      {
        "field": "agree",
        "type": "quantitative",
        "title": "Agree"
      },
      {
        "field": "disagree",
        "type": "quantitative",
        "title": "Disagree"
      },
      {
        "field": "agreement_percent",
        "type": "quantitative",
        "title": "Raw agreement (%)"
      },
      {
        "field": "kappa",
        "title": "Cohen’s kappa"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#26755b"
      },
      "encoding": {
        "x": {
          "field": "agreement_percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Exact agreement (%)"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "x": {
          "value": 8
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
