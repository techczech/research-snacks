{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 560,
  "height": 240,
  "background": "#fbfaf7",
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "Cognitive use: two passes of the same model",
    "subtitle": [
      "The same 51 metaphor-marked word units in both passes",
      "Pass A had manuscript/codebook context; Pass B started fresh"
    ]
  },
  "data": {
    "url": "charts/1-cognitive-use.csv"
  },
  "params": [
    {
      "name": "pass_select",
      "select": {
        "type": "point",
        "fields": [
          "pass_id"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal",
      "title": "Assigned cognitive use",
      "sort": [
        "attributive",
        "constitutive",
        "mixed",
        "uncertain"
      ],
      "axis": {
        "labelAngle": 0
      }
    },
    "xOffset": {
      "field": "pass_id",
      "type": "nominal"
    },
    "y": {
      "field": "units",
      "type": "quantitative",
      "title": "Units among the common 51",
      "axis": {
        "tickMinStep": 1
      }
    },
    "color": {
      "field": "pass_id",
      "type": "nominal",
      "title": "Pass",
      "scale": {
        "domain": [
          "A",
          "B"
        ],
        "range": [
          "#176a8a",
          "#c36b20"
        ]
      }
    },
    "opacity": {
      "condition": {
        "param": "pass_select",
        "value": 1
      },
      "value": 0.25
    },
    "tooltip": [
      {
        "field": "pass_id",
        "title": "Pass"
      },
      {
        "field": "category",
        "title": "Cognitive use"
      },
      {
        "field": "units",
        "type": "quantitative",
        "title": "Units"
      },
      {
        "field": "n",
        "type": "quantitative",
        "title": "Common metaphor units"
      },
      {
        "field": "documents",
        "type": "quantitative",
        "title": "Passages"
      }
    ]
  }
}
